                        "name": "grafanacloud-logs"
                      },
                      "group": "loki",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "quantile_over_time(0.50, {service_name=\"shop-api\"} |= \"query.monitor_active\" | unwrap duration_ms [5m])",
