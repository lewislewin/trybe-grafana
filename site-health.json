                      "datasource": {
                        "name": "grafanacloud-logs"
                      },
                      "group": "loki",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (site_id) (count_over_time({service_name=\"shop-api\"} |= \"basket.created\"| site_id=~\"$site_id\" [1h])) - sum by (site_id) (count_over_time({service_name=\"shop-api\"} |= \"basket.submitted\"| site_id=~\"$site_id\" [1h]))",
                        "queryType": "range",
                        "legendFormat": "{{site_id}}"
                      },
                      "version": "v0"
                    },
                    "refId": "Q3"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Positive gap = created but not submitted in the last hour",
          "id": 3,
          "links": [],
          "title": "Broken Checkout Detector",
