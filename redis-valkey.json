                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "app_redis_instantaneous_ops_per_sec{scrape_job=~\"$environment\"}"
